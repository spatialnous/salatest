{
    "rundir": [
        "rundir",
        "kr_isovist"
    ],
    "basebinlocation": "BaselineBinaries",
    "testbinlocation": "../build-RegressionTest",
    "allowskip": true,
    "knownresult": {
        "resultsdir": [
            "expected",
            "isovist"
        ]
    },
    "testcases": {
        "isovist_args": {
            "minVersion": "0.8.0",
            "compareFiles": [
                "out.mif",
                "out.mid"
            ],
            "steps": [
                {
                    "infile": "../../../../testdata/gallery_empty.graph",
                    "outfile": "out.graph",
                    "mode": "ISOVIST",
                    "extraArgs": {
                        "-ii": [
                            "1.77,6.6,90,30",
                            "3.1,5.6,270,90"
                        ]
                    }
                },
                {
                    "infile": "out.graph",
                    "outfile": "out.graph",
                    "mode": "MAPCONVERT",
                    "extraArgs": {
                        "-co": "convex",
                        "-con": "Convex Map Test"
                    }
                },
                {
                    "infile": "out.graph",
                    "outfile": "out.mif",
                    "mode": "EXPORT",
                    "extraArgs": {
                        "-em": "shapegraph-map-mif"
                    }
                }
            ]
        },
        "isovist_file": {
            "minVersion": "0.8.0",
            "compareFiles": [
                "out.mif",
                "out.mid"
            ],
            "steps": [
                {
                    "infile": "../../../../testdata/gallery_empty.graph",
                    "outfile": "out.graph",
                    "mode": "ISOVIST",
                    "extraArgs": {
                        "-if": "../../../../testdata/isovists.csv"
                    }
                },
                {
                    "infile": "out.graph",
                    "outfile": "out.graph",
                    "mode": "MAPCONVERT",
                    "extraArgs": {
                        "-co": "convex",
                        "-con": "Convex Map Test"
                    }
                },
                {
                    "infile": "out.graph",
                    "outfile": "out.mif",
                    "mode": "EXPORT",
                    "extraArgs": {
                        "-em": "shapegraph-map-mif"
                    }
                }
            ]
        }
    }
}