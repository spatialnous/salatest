#!/bin/bash

set -e

reuse lint
echo "Running clang-format..."
for FILE in $(git diff --cached --name-only --diff-filter=d ':!ThirdParty' | grep -E '.*\.(c|cpp|h|hpp)$')
do
    echo "Checking file: $FILE"
    clang-format --dry-run --Werror -style=file:.clang-format $FILE
done
echo "clang-format satisfied"

echo "Running clang-tidy (include-cleaner)..."
CPP_FILES=$(git diff --cached --name-only --diff-filter=d ':!ThirdParty' | grep -E '\.cpp$' || true)

# version_defs.hpp is generated by configure_file into the build directory, so
# a build dir has to be on the include path or dmcli/commandlineparser.cpp
# cannot be parsed.
TIDY_INC="-I. -isystem ThirdParty/Catch -isystem ThirdParty/FakeIt"
TIDY_BUILD_DIR=$(ls -d build*/ 2>/dev/null | head -1)
if [ -n "$TIDY_BUILD_DIR" ]; then
    TIDY_INC="$TIDY_INC -I${TIDY_BUILD_DIR%/}"
fi

if [ -n "$CPP_FILES" ]; then
    TIDY_OUTPUT=$(clang-tidy --quiet \
        -checks='-*,misc-include-cleaner' \
        -config='{CheckOptions: [{key: misc-include-cleaner.IgnoreHeaders, value: ".*[.]hpp;.*[.]h"}]}' \
        $CPP_FILES -- -std=c++17 $TIDY_INC 2>&1 || true)

    # A file that fails to parse produces no include-cleaner findings, so a
    # broken parse would otherwise be indistinguishable from a clean one.
    if printf '%s\n' "$TIDY_OUTPUT" | grep -q 'clang-diagnostic-error'; then
        echo "clang-tidy could not parse some files:"
        printf '%s\n' "$TIDY_OUTPUT" | grep 'clang-diagnostic-error'
        exit 1
    fi

    ISSUE_COUNT=$(printf '%s\n' "$TIDY_OUTPUT" | grep -c 'no header providing' || true)

    if [ "$ISSUE_COUNT" -gt 0 ]; then
        echo "clang-tidy found $ISSUE_COUNT missing-include issue(s):"
        printf '%s\n' "$TIDY_OUTPUT" | grep 'no header providing'
        echo "Run the clang-tidy --fix command manually, review, then re-stage."
        exit 1
    fi
fi
echo "clang-tidy satisfied"
